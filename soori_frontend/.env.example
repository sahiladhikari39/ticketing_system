VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Only used when this app is embedded in an iframe on another site.
# postMessage's target-origin argument is a restriction, not an
# address: unset, we fall back to "*", meaning any page that manages
# to frame us can read the height messages we send. Naming the host
# site here makes the browser drop those messages if anyone else
# frames us. Scheme included, no trailing slash.
# VITE_EMBED_PARENT_ORIGIN=https://globalnepalgroup.com
