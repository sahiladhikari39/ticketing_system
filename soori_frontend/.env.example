# Where the API lives.
#
# Served under /support on the client's website (the normal setup), use
# a RELATIVE path. Their proxy forwards /support/api through to Django,
# so requests stay same-origin: no CORS preflights, and cookies are
# sent automatically.
VITE_API_BASE_URL=/support/api

# Running this app standalone instead, against a local Django, use the
# absolute URL and set VITE_BASE_PATH=/ so it serves from the root:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Serve from a different path prefix, or "/" for a domain root.
# Must match the host site's proxy rules. Defaults to /support/.
# VITE_BASE_PATH=/support/
