# Copy this file to ".env" (same folder as manage.py) and fill in real
# values -- .env itself should NEVER be committed or shared, since it
# holds real credentials.

# ================================================================
# LOCAL DEVELOPMENT -- the only line you need to run locally.
#
# Without this, the app assumes production and refuses to start
# without a real secret key and hostname list. That refusal is
# intentional: it means a real deployment can't silently run with
# debug pages exposed.
# ================================================================
DJANGO_DEBUG=true


# ================================================================
# PRODUCTION -- required when DJANGO_DEBUG is false or absent.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# DJANGO_ALLOWED_HOSTS is a comma-separated list of the exact
# domains this site answers to. Never use "*" -- that allows
# Host-header poisoning, where an attacker can make password-reset
# links in emails point at their own server.
# ================================================================
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=paste-a-long-random-value-here
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Set to false ONLY if a load balancer or reverse proxy already
# redirects HTTP to HTTPS for you -- otherwise both will try and
# you get a redirect loop.
# DJANGO_SSL_REDIRECT=true

# Starts at 1 hour deliberately. HSTS can't be undone remotely once
# a browser caches it, so confirm HTTPS works, then raise to
# 31536000 (one year).
# DJANGO_HSTS_SECONDS=3600


# ================================================================
# EMBEDDING -- only needed when another site iframes this app.
#
# DJANGO_FRAME_ANCESTORS is the list of origins allowed to embed
# Soori. Leave it UNSET and nothing can frame us at all (Django's
# X-Frame-Options: DENY stays in force), which is the right default
# for a standalone deployment. Setting it swaps that header for a
# Content-Security-Policy frame-ancestors directive, because
# X-Frame-Options cannot express "allow this one other origin" --
# SAMEORIGIN is not enough, since support.example.com framed by
# example.com is a different origin.
#
# Scheme included, no trailing slash, comma-separated:
# DJANGO_FRAME_ANCESTORS=https://globalnepalgroup.com,https://www.globalnepalgroup.com

# Which origins may call this API from a browser. In local dev, an
# unset value falls back to the usual localhost ports. With
# DJANGO_DEBUG=false, an unset value allows NOTHING -- so a real
# deployment has to name its frontend explicitly.
# DJANGO_CORS_ALLOWED_ORIGINS=https://support.globalnepalgroup.com

# Needed for the Django admin / DRF browsable API over HTTPS behind
# a proxy. The JWT API doesn't use CSRF, so this isn't what makes
# the React frontend work.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://support.globalnepalgroup.com


# ----------------------------------------------------------------
# Gmail SMTP -- how to get these two values:
#
# 1. Turn on 2-Step Verification on the Gmail account you want to
#    send from: https://myaccount.google.com/security
# 2. Once that's on, a new option appears: "App passwords"
#    (https://myaccount.google.com/apppasswords). Generate one -- pick
#    any name, e.g. "Soori". Google shows you a 16-character code.
# 3. EMAIL_HOST_USER is the full Gmail address itself.
#    EMAIL_HOST_PASSWORD is that 16-character App Password -- paste it
#    with NO spaces, even though Google displays it with spaces.
#
# Your REGULAR Gmail login password will NOT work here and will fail
# every time -- Google has blocked that for third-party apps since
# 2022. It must be an App Password specifically.
# ----------------------------------------------------------------

# Left COMMENTED OUT deliberately. Copying this file over an
# existing .env would otherwise replace real working credentials
# with these placeholders -- which look 'set' to the app, so it
# switches to real SMTP, stops printing to your terminal, and then
# fails against Gmail. Uncomment and fill in only when you have
# actual values.
# EMAIL_HOST_USER=youraddress@gmail.com
# EMAIL_HOST_PASSWORD=your16digitapppassword
